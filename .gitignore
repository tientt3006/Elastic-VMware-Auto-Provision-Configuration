# Master environment and sensitive credential files
.env*
*.env
!*.env.example
*.pem
*.key
*.pfx
id_rsa*
id_ed25519*
*.iso
iso_cache/


# Terraform local states and cache
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ansible runtime artifacts and auto-generated shared env
*.retry
ansible/products/*/inventories/*/group_vars/all/shared_env.yml
.vault_pass*

# Packer build caches
packer_cache/
*.box

# OS, editor, and IDE temporary artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Auto-generated runtime config files (Secrets / Site-specific)
vars.conf
products/*/*.conf
!products/*/*.conf.example
backup_pre_refactor_gd1/
*.pkrvars.hcl
!*.pkrvars.hcl.example
ansible/products/*/inventories/*/hosts.yml
ansible/products/*/inventories/*/group_vars/all/main.yml
packer/templates/*/http/user-data

# Execution and deploy logs
*.log
