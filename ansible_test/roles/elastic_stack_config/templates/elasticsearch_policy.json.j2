{
  "name": "elasticsearch-default",
  "description": "Elasticsearch Integration for Default Policy",
  "namespace": "default",
  "policy_id": "default-policy",
  "package": {
    "name": "elasticsearch",
    "title": "Elasticsearch",
    "version": "{{ elasticsearch_package_info.json.item.version }}"
