            "exclude_files": [
              ".gz$"
            ],
            "exclude_lines": [
              "^(OpenJDK|Java HotSpot).* Server VM ",
              "^CommandLine flags: ",
              "^Memory: ",
              "^{"
            ],
            "multiline": {
              "pattern": "^(\\[?[0-9]{4}-[0-9]{2}-[0-9]{2}|{)",
              "negate": true,
              "match": "after"
