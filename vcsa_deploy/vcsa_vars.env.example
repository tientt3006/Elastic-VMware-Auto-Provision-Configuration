# ==============================================================================
# File: vcsa_vars.env.example
# Muc dich: Khai bao cac thong so ha tang khong nhay cam cho qua trinh cai VCSA
# Luu y: Mat khau duoc nhap truc tiep qua terminal an khi chay script, khong luu o day
# ==============================================================================

# 1. Thong tin ESXi Host muc tieu (Noi se khoi tao may ao VCSA)
ESXI_HOSTNAME="10.255.242.10"
ESXI_USERNAME="root"
DEPLOYMENT_NETWORK="VM Network"
DATASTORE_NAME="datastore1"

# 2. Cau hinh cau hinh may ao VCSA
# tiny: 2 vCPU, 14GB RAM (ho tro toi da 10 host / 100 VM)
# small: 4 vCPU, 19GB RAM (ho tro toi da 100 host / 1,000 VM)
VCSA_SIZE="tiny"
VCSA_VM_NAME="srv-vcsa-primary"

# 3. Thong so he dieu hanh va SSO vSphere
NTP_SERVERS="pool.ntp.org"
SSO_DOMAIN_NAME="vsphere.local"

# 4. Thong so mang may ao VCSA (Static IP bat buoc)
VCSA_STATIC_IP="10.255.242.20"
VCSA_PREFIX="24"
VCSA_GATEWAY="10.255.242.1"
DNS_SERVER_PRIMARY="10.255.242.1"
DNS_SERVER_SECONDARY="8.8.8.8"

# FQDN phai duoc phan giai xuoi va nguoc (A record va PTR record) tren DNS
VCSA_FQDN="vcsa.lab.internal"

# 5. Duong dan tep ISO VCSA cuc bo tren may Automation
VCSA_ISO_PATH="/var/tmp/iso_cache/VMware-VCSA-all-8.0.2.iso"
