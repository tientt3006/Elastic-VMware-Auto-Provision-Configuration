# ==============================================================================
# Automated Inventory Generated by Terraform (Windows Server 2025 Profile)
# ==============================================================================
all:
  vars:
    ansible_user: Administrator
    ansible_password: "${windows_admin_password}"
    ansible_connection: winrm
    ansible_winrm_server_cert_validation: ignore
    ansible_port: 5985
  children:
%{ for role in distinct([for k, vm in vms : vm.role if vm.role != null && vm.role != ""]) ~}
    ${role}:
      hosts:
%{ for k, vm in vms ~}
%{ if vm.role == role ~}
        ${vm.name}:
          ansible_host: ${vm.ip_address}
%{ endif ~}
%{ endfor ~}

%{ endfor ~}
    windows_nodes:
      hosts:
%{ for k, vm in vms ~}
        ${vm.name}:
          ansible_host: ${vm.ip_address}
%{ endfor ~}
