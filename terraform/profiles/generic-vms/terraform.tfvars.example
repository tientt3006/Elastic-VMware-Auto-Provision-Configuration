# ==============================================================================
# vCenter Server Connection Configuration
# ==============================================================================
vsphere_server              = "<VCENTER_IP>"
vsphere_user                = "<VCENTER_USER>"
vsphere_insecure_connection = true

# ==============================================================================
# vSphere Infrastructure Targets
# ==============================================================================
vsphere_datacenter    = "<VCENTER_DATACENTER>"
vsphere_cluster       = "<VCENTER_CLUSTER>"
vsphere_datastore     = "<VCENTER_DATASTORE>"
# Default Golden Template fallback (used if a VM in 'vms' does not specify 'template_name')
vsphere_template_name = "<DEFAULT_VM_TEMPLATE_NAME>"

# [TÙY CHỌN] Mật khẩu Administrator cho máy ảo Windows qua Sysprep (bỏ qua nếu muốn giữ mật khẩu gốc của template)
# windows_admin_password = "<WINDOWS_ADMIN_PASSWORD>"
# windows_workgroup      = "WORKGROUP"

# ==============================================================================
# Inventory Folder Configuration
# ==============================================================================
vm_folders       = ["<VCENTER_FOLDER>"]
vm_target_folder = "<VCENTER_FOLDER>"

# ==============================================================================
# ESXi Host & Standard Switch Configuration (Optional port groups)
# ==============================================================================
esxi_hosts          = []
virtual_switch_name = "vSwitch0"
port_groups         = {}

default_domain_name = "lab.local"
default_dns_servers = ["8.8.8.8", "1.1.1.1"]

# ==============================================================================
# OS Credentials (Ansible Integration for Linux VMs)
# ==============================================================================
ssh_username   = "<SSH_USER>"
ssh_public_key = "<YOUR_SSH_PUBLIC_KEY>"

# ==============================================================================
# DRS Cluster Rules Configuration
# ==============================================================================
enable_drs_rule    = false
drs_rule_mandatory = false

# ==============================================================================
# Virtual Machine Workloads (Hỗ trợ đa hệ điều hành đồng thời: Ubuntu, Rocky, Windows)
# ==============================================================================
vms = {
  # 1. Máy ảo Ubuntu Linux (sử dụng template_name riêng hoặc fallback)
  "web_ubuntu" = {
    name          = "<VM_NAME_1>"
    hostname      = "web-ubuntu-01"
    template_name = "template-ubuntu-24.04"
    cpu_count     = 2
    memory_mb     = 4096
    disk_size_gb  = 40
    network_name  = "<VCENTER_NETWORK>"
    ip_address    = "<VM_IP_1>"
    netmask       = 24
    gateway       = "<GATEWAY_IP>"
    role          = "web_server"
  },

  # 2. Máy ảo Rocky Linux 9 (sử dụng template Rocky Linux)
  "app_rocky" = {
    name          = "<VM_NAME_2>"
    hostname      = "app-rocky-01"
    template_name = "template-rocky-9"
    cpu_count     = 2
    memory_mb     = 4096
    disk_size_gb  = 40
    network_name  = "<VCENTER_NETWORK>"
    ip_address    = "<VM_IP_2>"
    netmask       = 24
    gateway       = "<GATEWAY_IP>"
    role          = "app_server"
  },

  # 3. Máy ảo Windows Server (tự động cấu hình sysprep windows_options & WinRM)
  "win_srv" = {
    name          = "<VM_NAME_3>"
    hostname      = "win-srv-01"
    template_name = "template-windows-server-2025"
    cpu_count     = 4
    memory_mb     = 6144
    disk_size_gb  = 60
    network_name  = "<VCENTER_NETWORK>"
    ip_address    = "<VM_IP_3>"
    netmask       = 24
    gateway       = "<GATEWAY_IP>"
    role          = "windows_server"
  }
}

# ==============================================================================
# Ansible Inventory Generation Options
# ==============================================================================
generate_ansible_inventory = true
# ansible_inventory_path   = "./hosts.yml"
