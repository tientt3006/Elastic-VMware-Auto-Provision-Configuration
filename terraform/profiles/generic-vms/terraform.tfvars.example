# ==============================================================================
# vCenter Server Connection Configuration
# ==============================================================================
vsphere_server              = "<VCENTER_IP>"
vsphere_user                = "<VCENTER_USER>"
vsphere_insecure_connection = true

# ==============================================================================
# vSphere Infrastructure Targets
# ==============================================================================
vsphere_datacenter    = "<VCENTER_DATACENTER>"
vsphere_cluster       = "<VCENTER_CLUSTER>"

# Datastore lưu trữ mặc định cho toàn bộ máy ảo.
# TÙY CHỌN: Có thể để trống ("") nếu TẤT CẢ các máy ảo trong 'vms' đều đã tự khai báo 'datastore_name' riêng.
vsphere_datastore     = "<VCENTER_DATASTORE>"

# Template mặc định cấp phát khi một máy ảo trong 'vms' không chỉ định riêng 'template_name'
# TÙY CHỌN: Có thể để trống ("") nếu TẤT CẢ các máy ảo trong 'vms' đều đã chỉ định 'template_name' riêng.
vsphere_template_name = "<DEFAULT_VM_TEMPLATE_NAME>"

# [TÙY CHỌN] Mật khẩu Administrator chung cho các máy ảo Windows qua Sysprep
# Bỏ qua (comment) nếu muốn giữ mật khẩu gốc của template hoặc muốn cấu hình mật khẩu riêng cho từng máy trong 'vms'
# windows_admin_password = "<WINDOWS_ADMIN_PASSWORD>"
# windows_workgroup      = "WORKGROUP"

# ==============================================================================
# Inventory Folder Configuration
# ==============================================================================
vm_folders       = ["<VCENTER_FOLDER>"]
vm_target_folder = "<VCENTER_FOLDER>"

# ==============================================================================
# ESXi Host & Standard Switch Configuration (Optional port groups)
# ==============================================================================
esxi_hosts          = []
virtual_switch_name = "vSwitch0"
port_groups         = {}

default_domain_name = "lab.local"
default_dns_servers = ["8.8.8.8", "1.1.1.1"]

# ==============================================================================
# OS Credentials (Ansible Integration for Linux VMs)
# ==============================================================================
# Bỏ trống nếu không dùng Ansible hoặc không muốn inject SSH key vào máy ảo
ssh_username   = "<SSH_USER>"
ssh_public_key = "<YOUR_SSH_PUBLIC_KEY>"

# ==============================================================================
# DRS Cluster Rules Configuration
# ==============================================================================
enable_drs_rule    = false
drs_rule_mandatory = false

# ==============================================================================
# Virtual Machine Workloads (Hỗ trợ đa hệ điều hành: Ubuntu, Rocky, Windows,...)
# ==============================================================================
vms = {
  # ----------------------------------------------------------------------------
  # Máy ảo 1: Cấu hình cơ bản (Linux) kèm giải thích toàn bộ tùy chọn có thể có
  # ----------------------------------------------------------------------------
  "node_linux_01" = {
    # [BẮT BUỘC] Thông tin định danh và tài nguyên tính toán cơ bản
    name         = "<VM_NAME_1>"
    hostname     = "node-linux-01"
    cpu_count    = 2
    memory_mb    = 4096
    disk_size_gb = 40
    network_name = "<VCENTER_NETWORK>"
    ip_address   = "<VM_IP_1>"
    netmask      = 24
    gateway      = "<GATEWAY_IP>"

    # [TÙY CHỌN] Template nguồn để clone máy ảo:
    # Điền tên template cụ thể cho máy ảo này (ví dụ: "<UBUNTU_TEMPLATE_NAME>", "<ROCKY_TEMPLATE_NAME>").
    # Mặc định khi không điền (comment): Kế thừa từ biến toàn cục 'vsphere_template_name'.
    # template_name = "<SPECIFIC_TEMPLATE_NAME>"

    # [TÙY CHỌN] Nhãn vai trò chức năng (Role):
    # Người dùng có thể tùy ý đặt tên bất kỳ theo nhu cầu phân loại hoặc vai trò nghiệp vụ
    # (ví dụ: "web_server", "db_master", "db_slave", "redis", "load_balancer", "monitoring", "k8s_node",...).
    # Không bị giới hạn vào một danh mục cố định nào.
    # Mục đích sử dụng:
    # 1. Tự động gom nhóm máy ảo trong file Ansible inventory (hosts.yml) phục vụ chạy playbook theo nhóm.
    # 2. Ghi vào thuộc tính vSphere metadata (guestinfo.node.role) phục vụ audit, giám sát và quản lý hạ tầng.
    # Mặc định khi không điền (comment): "generic" (máy ảo chỉ thuộc nhóm chung all_nodes/linux_nodes/windows_nodes).
    # role = "web_server"

    # [TÙY CHỌN] Thư mục vSphere chứa máy ảo:
    # Tên thư mục trong vCenter Inventory muốn đặt máy ảo vào.
    # Mặc định khi không điền (comment): Kế thừa từ biến toàn cục 'vm_target_folder'.
    # folder_name = "<SPECIFIC_FOLDER_NAME>"

    # [TÙY CHỌN] Datastore lưu trữ riêng cho máy ảo này:
    # Tên Datastore trên vCenter muốn đặt máy ảo vào (ví dụ: "datastore1", "SAN-Storage-01").
    # Mặc định khi không điền (comment): Kế thừa từ biến toàn cục 'vsphere_datastore'.
    # datastore_name = "<SPECIFIC_DATASTORE_NAME>"

    # [TÙY CHỌN] Máy chủ ESXi vật lý chỉ định để đặt máy ảo (Host Pinning):
    # Địa chỉ IP hoặc FQDN của ESXi Host trong cụm Cluster muốn chạy máy ảo này.
    # Mặc định khi không điền (comment): vCenter DRS tự động phân bổ máy ảo lên ESXi host phù hợp nhất trong Cluster.
    # host_name = "<ESXI_HOST_IP_OR_FQDN>"

    # [TÙY CHỌN] Danh sách máy chủ DNS resolver riêng:
    # Danh sách địa chỉ IP máy chủ phân giải tên miền riêng cho máy ảo này.
    # Mặc định khi không điền (comment): Kế thừa từ danh sách toàn cục 'default_dns_servers'.
    # dns_servers = ["8.8.8.8", "1.1.1.1"]

    # [TÙY CHỌN] Tính năng cắm nóng tài nguyên phần cứng (Hot-Plug):
    # cpu_hot_add_enabled: Cho phép tăng số lượng vCPU khi máy ảo đang hoạt động mà không cần tắt nguồn (mặc định: true).
    # memory_hot_add_enabled: Cho phép tăng dung lượng RAM khi máy ảo đang hoạt động mà không cần tắt nguồn (mặc định: true).
    # cpu_hot_add_enabled    = true
    # memory_hot_add_enabled = true

    # [TÙY CHỌN] Chế độ cấp phát ổ đĩa chính (OS Root Disk - disk0):
    # disk_thin_provisioned: true  = Thin Provision (cấp phát theo dung lượng thực tế dùng, tiết kiệm lưu trữ).
    #                        false = Thick Provision (cấp phát toàn bộ dung lượng cố định ngay khi tạo).
    # Mặc định khi không điền (comment): Kế thừa từ template gốc (thông thường là true).
    # disk_eagerly_scrub:    true  = Thick Provision Eager Zeroed (ghi đè số 0 toàn bộ khối dữ liệu trước khi dùng).
    #                        false = Thick Provision Lazy Zeroed (chỉ áp dụng khi disk_thin_provisioned = false).
    # Mặc định khi không điền (comment): false.
    # disk_thin_provisioned = true
    # disk_eagerly_scrub    = false

    # [TÙY CHỌN] Cấu hình bổ sung nhiều ổ đĩa phụ (Extra Data Disks):
    # Cho phép gắn thêm một hoặc nhiều ổ đĩa dữ liệu ngoài ổ đĩa hệ điều hành.
    # Mặc định khi không điền (comment): Không tạo thêm ổ đĩa phụ ([]).
    # extra_disks = [
    #   {
    #     size_gb          = 100               # [Bắt buộc] Dung lượng ổ đĩa phụ tính bằng GB
    #     label            = "disk-data-01"    # [Tùy chọn] Nhãn ổ đĩa trên vSphere (mặc định: disk1, disk2,...)
    #     thin_provisioned = true              # [Tùy chọn] Chế độ Thin (mặc định: true)
    #     eagerly_scrub    = false             # [Tùy chọn] Chế độ Eager Scrub (mặc định: false)
    #     datastore_name   = "<DATASTORE_NAME>"# [Tùy chọn] Lưu trên datastore khác (mặc định: cùng datastore với VM)
    #   }
    # ]
  },

  # ----------------------------------------------------------------------------
  # Máy ảo 2: Ví dụ máy ảo đa ổ đĩa và thư mục riêng biệt (Database / Storage)
  # ----------------------------------------------------------------------------
  "node_db_01" = {
    name          = "<VM_NAME_2>"
    hostname      = "node-db-01"
    template_name = "<ROCKY_OR_LINUX_TEMPLATE_NAME>"
    cpu_count     = 4
    memory_mb     = 8192
    disk_size_gb  = 50
    network_name  = "<VCENTER_NETWORK>"
    ip_address    = "<VM_IP_2>"
    netmask       = 24
    gateway       = "<GATEWAY_IP>"

    # Ví dụ khai báo role tùy ý cho cụm cơ sở dữ liệu
    # role = "db_master"

    # Thư mục riêng cho cụm database
    # folder_name = "<DB_FOLDER_NAME>"

    # Datastore riêng cho cụm database
    # datastore_name = "<DB_DATASTORE_NAME>"

    # Cấu hình 2 ổ đĩa phụ: 1 ổ cho dữ liệu DB, 1 ổ cho transaction log
    # extra_disks = [
    #   {
    #     size_gb          = 200
    #     label            = "disk-db-data"
    #     thin_provisioned = true
    #   },
    #   {
    #     size_gb          = 50
    #     label            = "disk-db-wal"
    #     thin_provisioned = true
    #   }
    # ]
  },

  # ----------------------------------------------------------------------------
  # Máy ảo 3: Máy ảo Windows Server (Sysprep windows_options & WinRM)
  # ----------------------------------------------------------------------------
  "node_win_01" = {
    name          = "<VM_NAME_3>"
    hostname      = "win-srv-01"
    template_name = "<WINDOWS_TEMPLATE_NAME>"
    cpu_count     = 4
    memory_mb     = 6144
    disk_size_gb  = 60
    network_name  = "<VCENTER_NETWORK>"
    ip_address    = "<VM_IP_3>"
    netmask       = 24
    gateway       = "<GATEWAY_IP>"

    # Ví dụ khai báo role cho máy chủ Windows
    # role = "windows_server"

    # [TÙY CHỌN] Mật khẩu Administrator riêng biệt cho máy ảo Windows này:
    # Ghi đè mật khẩu riêng cho máy ảo này trong quá trình Sysprep.
    # Mặc định khi không điền (comment): Kế thừa từ biến toàn cục 'windows_admin_password',
    # hoặc giữ nguyên mật khẩu gốc của template nếu cả hai đều bỏ qua.
    # admin_password = "<WINDOWS_VM_SPECIFIC_PASSWORD>"

    # [TÙY CHỌN] Tên Workgroup riêng cho máy ảo Windows này (mặc định: "WORKGROUP")
    # workgroup = "WORKGROUP"

    # [TÙY CHỌN] Datastore và Host ESXi riêng
    # datastore_name = "<SPECIFIC_DATASTORE_NAME>"
    # host_name      = "<ESXI_HOST_IP_OR_FQDN>"

    # cpu_hot_add_enabled    = true
    # memory_hot_add_enabled = true
  }
}

# ==============================================================================
# Ansible Inventory Generation Options
# ==============================================================================
generate_ansible_inventory = true
# ansible_inventory_path   = "./hosts.yml"
