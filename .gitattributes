# ==============================================================================
# Git Attributes Line Ending and Binary Normalization Configuration
# ==============================================================================

# Default fallback: auto-detect text files and normalize to LF
* text=auto eol=lf

# Shell scripts and executables (MANDATORY LF)
*.sh text eol=lf
*.bash text eol=lf

# Infrastructure as Code, Automation, and Configuration Files
*.hcl text eol=lf
*.pkr.hcl text eol=lf
*.pkrvars.hcl text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.service text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Binary Files (Prevent Git from modifying line endings)
*.iso binary
*.ova binary
*.ovf binary
*.vmdk binary
*.tar binary
*.gz binary
*.tgz binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
