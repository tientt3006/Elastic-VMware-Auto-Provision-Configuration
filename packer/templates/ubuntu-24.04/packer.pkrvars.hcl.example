# ==============================================================================
# Sample Environment Variables for Ubuntu 24.04 Template Build
# Rename or copy to packer.pkrvars.hcl and supply infrastructure values.
# Sensitive passwords (vcenter_password, ssh_password) must NOT be stored here;
# inject them via memory (PKR_VAR_*) or via scripts/build_packer_secure.sh.
# ==============================================================================

vcenter_server              = "<VCENTER_IP>"
vcenter_user                = "<VCENTER_USER>"
vcenter_insecure_connection = true

vcenter_datacenter          = "<VCENTER_DATACENTER>"
vcenter_cluster             = "<VCENTER_CLUSTER>"
vcenter_resource_pool       = ""
vcenter_datastore           = "<VCENTER_DATASTORE>"
vcenter_network             = "<VCENTER_NETWORK>"
vcenter_folder              = "<VCENTER_FOLDER>"

iso_paths = [
  "[<VCENTER_DATASTORE>] <PATH_TO_ISO>"
]

vm_name                     = "<VM_TEMPLATE_NAME>"
vm_cpu_cores                = 2
vm_cpu_sockets              = 1
vm_mem_size                 = 4096
vm_disk_size                = 40960
vm_disk_thin                = true
vm_cdrom_type               = "ide"

ssh_username                = "<SSH_USER>"
ssh_timeout                 = "30m"
