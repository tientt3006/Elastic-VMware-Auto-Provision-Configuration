# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars and .tfvars.json files with sensitive credentials
*.tfvars
*.tfvars.json

# Whitelist example files
!*.tfvars.example
!*.tfvars.json.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Plan files
tfplan
*.tfplan
